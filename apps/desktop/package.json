{
  "name": "@fruitboard/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build --no-bundle",
    "dev": "tauri dev",
    "frontend:build": "pnpm --filter @fruitboard/client build",
    "frontend:dev": "pnpm --filter @fruitboard/client dev",
    "package:windows:smoke": "tauri build --ci --no-sign --config src-tauri/tauri.package.conf.json --features packaging-smoke --bundles nsis",
    "package:windows:analysis-smoke": "tauri build --ci --no-sign --config src-tauri/tauri.package.conf.json --features analysis-jobs --bundles nsis",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
